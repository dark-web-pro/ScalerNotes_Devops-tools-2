pipeline{
    agent any
    stages{
        stage("git checkout"){
            steps{
                git 'https://github.com/akshu20791/addressbook-cicd-project'
            }
        }
        stage("build the project"){
            steps{
                sh 'mvn compile'
            }
        }
        stage("package the project"){
            steps{
                sh 'mvn package'
            }
        }
        stage("quality assurance"){
          parallel {
              stage("Checksyle code quality") {
                  steps {
                   sh 'mvn checkstyle:checkstyle'
                  }
              }
              stage("pmd code quality"){
                  steps{
                     sh  'mvn pmd:pmd'
                  }
               }
           }
        }
    }
}
